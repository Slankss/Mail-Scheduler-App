# --- Panel girisi (zorunlu) ---------------------------------------------
# Bu iki deger olmadan uygulama acilmaz; hicbir sayfa ve hicbir API ucu
# giris yapmadan kullanilamaz.
APP_USERNAME={APP_USERNAME}

# Sifrenin hash'i. Uretmek icin:
#   python auth.py hash
# (Duz metin sifre icin APP_PASSWORD kullanilabilir, ama hash tercih edilir.)
APP_PASSWORD_HASH={APP_PASSWORD_HASH}

# Uygulama HTTPS arkasinda calisiyorsa 1 yapin: oturum cookie'si sadece
# sifreli baglantida gonderilir. Duz http (localhost) icin 0 kalmali.
SESSION_COOKIE_SECURE=0

# --- Diger ---------------------------------------------------------------
ZERUH_API_KEY={ZERUH_API_KEY}

# SMTP/IMAP sifresini veritabaninda sifrelemek ve oturum cookie'sini imzalamak
# icin kullanilir. Rastgele bir deger uretip buraya yapistirin, ornek:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY={APP_SECRET_KEY}
